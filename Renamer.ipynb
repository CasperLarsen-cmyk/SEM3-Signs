   "source": [
    "from os import listdir\n",
    "import os\n",
    "\n",
    "Folder = \"./OURdata/OurCutsCopy/\"\n",
    "files = listdir(Folder)\n",
    "\n",
    "for i, file in enumerate(files):\n",
    "    exStart = file.rfind('.')\n",
    "    ext = file[exStart:]\n",
    "    os.rename(Folder+file, f\"{Folder}{i:0>3}{ext}\") \n"
   ]
